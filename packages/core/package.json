{
  "name": "@spectruth/core",
  "version": "0.1.0",
  "description": "Core verification engine for SpecTruth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "openai": "4.78.0",
    "glob": "11.0.0",
    "ignore": "6.0.2"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
