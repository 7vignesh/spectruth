{
  "name": "spectruth-core",
  "version": "0.2.0",
  "description": "Done Integrity engine — audits whether a completed spec task is actually supported by evidence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "author": "7vignesh",
  "homepage": "https://github.com/7vignesh/spectruth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7vignesh/spectruth.git",
    "directory": "packages/core"
  },
  "keywords": [
    "kiro",
    "spec-driven-development",
    "verification",
    "ai-agents",
    "done-integrity"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsc"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.39.0",
    "openai": ">=4.78.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "openai": "4.78.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@types/node": "22.10.2"
  }
}
